# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which documents the one variable the console needs and carries
# no secret by construction: NEXT_PUBLIC_ values are compiled into the client bundle. The
# scaffold's bare `.env*` is broader than the repo root's rule and silently swallowed it,
# which makes a committed example impossible rather than merely absent.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
