# Copy to .env.local for development. The default already points at a local API, so this
# file is only needed when the API lives somewhere else.
#
# NEXT_PUBLIC_ is required: the console talks to the API from the browser, so the value is
# compiled into the client bundle and is public by construction. Never put a secret behind
# this prefix — nothing here is one, and the API has no credential to hold anyway.
#
# In production this is set in the Vercel project settings to the Render service URL, and
# that same origin must appear in the API's AEGIS_API_CORS_ORIGINS or every request fails
# at the preflight.
NEXT_PUBLIC_AEGIS_API=http://localhost:8000
