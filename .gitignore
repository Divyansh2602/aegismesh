__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
# Secrets and credentials. Nothing in this repo needs an API key -- everything runs
# offline against a bundled deterministic model -- so anything matching these patterns
# arriving here is an accident, and the ignore list is the cheap half of not publishing it.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
credentials.json
service-account*.json
secrets.json
.secrets/
*.secret
.aws/
.gcloud/
id_rsa*
id_ed25519*
*.log

# Local transparency-log databases. The log's whole value is being append-only over time,
# so a deployment points AEGIS_API_LOG_DATABASE at a volume that survives restarts --
# but a checked-in copy would be a dead snapshot of somebody's laptop, and every root in
# it was signed by the published demo key. Keep the property, not the file.
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Local agent/editor state
.remember/
.claude/
.vscode/
.idea/
dist/
build/
node_modules/
.next/
.DS_Store
